# ==============================================================================
# GITHUB SECRETS CONFIGURATION REFERENCE
# ==============================================================================
# NOTE: This project's Python Flask application does NOT use a .env file to run. 
# It does not connect to external databases or require API keys.
# 
# The variables below represent the SECRETS that must be configured in your 
# GitHub Repository (Settings -> Secrets and variables -> Actions) for the 
# CI/CD pipeline (azure-app-service.yml) to deploy successfully.
# ==============================================================================

# AZURE_CREDENTIALS: 
# This is a JSON object generated by Azure when creating a Service Principal.
# It gives GitHub Actions permission to deploy to your Azure App Service.
# Command to generate: 
# az ad sp create-for-rbac --name "myApp" --role contributor --scopes /subscriptions/<subscription-id>/resourceGroups/<resource-group> --sdk-auth
AZURE_CREDENTIALS={"clientId": "xxx", "clientSecret": "xxx", "subscriptionId": "xxx", "tenantId": "xxx"}

# ==============================================================================
# DEFAULT GITHUB ENVIRONMENT VARIABLES (Automatically provided)
# ==============================================================================

# GITHUB_TOKEN:
# You do NOT need to set this manually. GitHub automatically generates this 
# temporary token during every workflow run. It is used to authenticate with 
# the GitHub Container Registry (ghcr.io) to push and pull Docker images.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
